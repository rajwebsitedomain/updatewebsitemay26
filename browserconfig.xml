<?xml version="1.0" encoding="utf-8"?>
<!--
  browserconfig.xml
  Place at: https://rajvardhansingh.in/browserconfig.xml
  
  Controls how your site appears when pinned to Windows Start Menu / Microsoft Edge.
  Also referenced by the HTML meta tag:
  <meta name="msapplication-config" content="/browserconfig.xml">
  
  Generate tile images at: https://realfavicongenerator.net
-->
<browserconfig>
  <msapplication>
    <tile>
      <!-- Square 70x70 tile -->
      <square70x70logo src="/images/icons/ms-icon-70x70.png"/>
      <!-- Square 150x150 tile (most common) -->
      <square150x150logo src="/images/icons/ms-icon-150x150.png"/>
      <!-- Wide 310x150 tile -->
      <wide310x150logo src="/images/icons/ms-icon-310x150.png"/>
      <!-- Square 310x310 tile (large) -->
      <square310x310logo src="/images/icons/ms-icon-310x310.png"/>
      <!-- Tile background colour (use your brand colour) -->
      <TileColor>#ffffff</TileColor>
    </tile>
    <notification>
      <polling-uri src="https://rajvardhansingh.in/rss.xml"/>
      <frequency>30</frequency>
      <cycle>1</cycle>
    </notification>
  </msapplication>
</browserconfig>
